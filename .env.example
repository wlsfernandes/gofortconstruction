# -----------------------------------------------------------------------------
# Fort Construction environment file
#
# Local:      cp .env.example .env && php artisan key:generate
# Production: copy this file to .env on the server and follow every "PROD:" note.
#             Never commit the real .env or any real password, key or token.
#
# After changing .env in production, run: php artisan config:cache
# -----------------------------------------------------------------------------

APP_NAME="Fort Construction"
# PROD: production
APP_ENV=local
# PROD: generate once on the server with `php artisan key:generate`, then never change it
#       (changing it logs everyone out and breaks encrypted data).
APP_KEY=
# PROD: false. true shows stack traces, config and secrets to visitors.
APP_DEBUG=true
# PROD: the public https address, no trailing slash, e.g. https://gofortconstruction.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# PROD: daily (rotates files in storage/logs so they do not grow forever)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PROD: error (debug logs too much and can include request details)
LOG_LEVEL=debug
# PROD (with LOG_STACK=daily): days of log files to keep
# LOG_DAILY_DAYS=14

# PROD: production PostgreSQL. Use a dedicated role that owns only this database,
#       and a long random password.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fortify_db
DB_USERNAME=fortify
DB_PASSWORD=
# PROD: require if the database is on another host, e.g. a managed PostgreSQL service
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
# PROD: true (session data is encrypted at rest in the sessions table)
SESSION_ENCRYPT=false
SESSION_PATH=/
# PROD: the site's domain, e.g. gofortconstruction.com, or leave null
SESSION_DOMAIN=null
# PROD: true, so the login cookie is only sent over https
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Uploaded images always use the "public" disk (storage/app/public), whatever this says.
# PROD: run `php artisan storage:link` once, and keep storage/app/public persistent and backed up.
FILESYSTEM_DISK=local
# Estimate-request emails are queued in the jobs table.
# PROD: keep `php artisan queue:work --tries=3` running under Supervisor or systemd,
#       or the emails are never sent.
QUEUE_CONNECTION=database

# Also caches the admin "Site settings" page values.
CACHE_STORE=database
# PROD: set a unique prefix if several apps share one cache store
# CACHE_PREFIX=

# Not used by this app unless CACHE_STORE / QUEUE_CONNECTION are switched to these.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PROD: a real mail provider. "log" only writes emails to storage/logs and sends nothing.
#       SMTP example:
#         MAIL_MAILER=smtp
#         MAIL_SCHEME=smtps        (port 465) or leave null for STARTTLS on port 587
#         MAIL_HOST=smtp.your-provider.com
#         MAIL_PORT=587
#         MAIL_USERNAME=your-smtp-user
#         MAIL_PASSWORD=your-smtp-password
#       Or MAIL_MAILER=resend with RESEND_API_KEY, or MAIL_MAILER=postmark with POSTMARK_API_KEY.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# PROD: an address on a domain your mail provider is verified for, e.g. no-reply@gofortconstruction.com
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# RESEND_API_KEY=
# POSTMARK_API_KEY=

# First administrator, created by `php artisan db:seed --class=AdminUserSeeder --force`.
# PROD: set these, run the seeder once, sign in, then remove the password from .env
#       and run `php artisan config:cache` again.
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Inbox that receives new estimate requests. Leave the line commented out to use
# Support@GoFortConstruction.com. Do not leave it uncommented and empty: an empty value
# overrides the default and estimate emails then have no recipient.
# CONTACT_RECIPIENT_EMAIL=estimates@gofortconstruction.com

# Not used by this app (uploads stay on local disk). Only needed if moving uploads to S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
